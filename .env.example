# Copy these values into your terminal environment before running the app.
# Keep real secrets private. Do not upload .env files to GitHub.
SECRET_KEY=replace-with-a-long-random-secret

# SMTP email reminders (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Brightloop <billing@example.com>

# Stripe TEST keys only for development
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
